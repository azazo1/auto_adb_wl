# Copy this file to .env and fill in your local values before building.

# Optional. Leave empty to disable lnd discovery entirely.
AUTO_ADB_WL_LND_BASE_URL=http://192.168.1.10:8765

# Optional. Leave empty when the lnd server does not require a bearer token.
AUTO_ADB_WL_LND_BEARER_TOKEN=

# Optional. Defaults to AutoADB._http._tcp when left empty.
AUTO_ADB_WL_LND_SERVICE_NAME=AutoADB._http._tcp
